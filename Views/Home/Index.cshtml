                        </p>

                    </div>

                </div>

                <div class="contact-item">

                    <i class="bi bi-envelope-fill"></i>

                    <div>

                        <strong>Hostel</strong>

                        <p>

                          ahmadmasroor856@gmail.com

                        </p>

                    </div>

                </div>

                <div class="contact-item">

                    <i class="bi bi-telephone-fill"></i>

                    <div>

                        <strong>Phone</strong>

                        <p>

                            +234 7042827492

                        </p>

                    </div>

                </div>

            </div>

            <form asp-controller="ContactMessage"
      asp-action="Send"
      method="post"
      class="contact-form">

    @Html.AntiForgeryToken()

    <div class="input-group">

        <input name="FullName"
               type="text"
               placeholder="Full Name"
               required />

    </div>

    <div class="input-group">

        <input name="Email"
               type="email"
               placeholder="Email Address"
               required />

    </div>

    <div class="input-group">

        <textarea name="Message"
                  rows="6"
                  placeholder="Your Message"
                  required></textarea>

    </div>

    <button type="submit"
            class="primary-btn">

        <i class="bi bi-send-fill me-2"></i>

        Send Message

    </button>

</form>

        </div>

    </div>

</section>


