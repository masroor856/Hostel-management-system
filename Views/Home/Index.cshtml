@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/home.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/animation.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/responsive.css"
      asp-append-version="true" />
<div class="landing-page">

  

    <!-- Hero starts here -->
   <section id="home" class="hero">

    <div class="hero-shape shape-1"></div>
    <div class="hero-shape shape-2"></div>
    <div class="hero-shape shape-3"></div>

    <div class="container hero-content">

        <div class="hero-left">

            <span class="hero-tag">
                Student Hostel Management System
            </span>

            <h1>
                Find Your Perfect
                <span>Hostel Room</span>
                Without Stress
            </h1>

            <p>
                Apply for hostel accommodation, track your application,
                make secure payments, and manage your hostel life
                from one modern platform.
            </p>

            <div class="hero-buttons">

                <a asp-controller="Account"
                   asp-action="Register"
                   class="hero-btn-primary">

                    Apply Now

                </a>

                <a href="#features"
                   class="hero-btn-secondary">

                    Learn More

                </a>

            </div>

        </div>

        <div class="hero-right">

            <img src="~/images/landing/hostel-hero.png"
                 alt="Hostel"
                 class="hero-image"/>

        </div>

    </div>

    <div class="scroll-indicator">

        <span></span>

    </div>

</section>
<!-- ===================================
     WHY CHOOSE US
=================================== -->

<section id="features" class="features reveal-scale">

    <div class="container">

        <div class="section-heading">

            <span>WHY CHOOSE US</span>

            <h2>

                Everything You Need
                In One Platform

            </h2>

            <p>

                Experience a smarter and faster way to apply,
                pay and manage hostel accommodation.

            </p>

        </div>

        <div class="feature-grid">

            <div class="feature-box">

                <div class="feature-icon">

                    🏠

                </div>

                <h3>

                    Smart Hostel Allocation

                </h3>

                <p>

                    Students can apply and receive room allocation
                    without paperwork.

                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">

                    💳

                </div>

                <h3>

                    Secure Payments

                </h3>

                <p>

                    Pay hostel fees online with complete security.

                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">

                    📱

                </div>

                <h3>

                    Track Applications

                </h3>

                <p>

                    Monitor every stage of your application
                    in real time.

                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">

                    🔒

                </div>

                <h3>

                    Secure Account

                </h3>

                <p>

                    Email verification and password recovery
                    protect every account.

                </p>

            </div>

        </div>

    </div>

</section>
<!-- ===================================
     HOSTEL SHOWCASE
=================================== -->

<section id="rooms" class="rooms reveal">

    <div class="container">

        <div class="section-heading">

            <span>HOSTEL FACILITIES</span>

            <h2>

                Comfortable Living Spaces

            </h2>

            <p>

                Modern hostel rooms designed for comfort,
                security and academic success.

            </p>

        </div>

        <div class="rooms-grid">

            <div class="room-large">

                <div class="room-overlay">
                  <img src="~/images/landing/boys-hostel.png"
                 alt="Hostel"
                 class="hero-image"/>  

                    <h2>Male Hostel</h2>

                    <p>

                        Spacious rooms with excellent
                        learning environment.

                    </p>

                </div>

            </div>

            <div class="room-small room-one">

                <div class="room-overlay">
                    <img src="~/images/landing/female-hostel.png"
                 alt="Hostel"
                 class="hero-image"/>

                    <h3>Female Hostel</h3>

                </div>

            </div>

            <div class="room-small room-two">

                <div class="room-overlay">
                    <img src="~/images/landing/reading-lounge.png"
                 alt="Hostel"
                 class="hero-image"/>

                    <h3>Reading Lounge</h3>

                </div>

            </div>

        </div>

    </div>

</section>
<!-- ===================================
     STATISTICS
=================================== -->

<section class="statistics reveal-scale">

    <div class="container">

        <div class="stats-grid">

            <div class="stat-item">

                <h2 class="counter" data-target="2500">0</h2>

                <p>Students Accommodated</p>

            </div>

            <div class="stat-item">

               <h2 class="counter" data-target="120">0</h2>

                <p>Hostel Rooms</p>

            </div>

            <div class="stat-item">

                <h2 class="counter" data-target="98">0</h2>

                <p>Student Satisfaction</p>

            </div>

            <div class="stat-item">

               <h2 class="counter" data-target="24">0</h2>

                <p>Support Available</p>

            </div>

        </div>

    </div>

</section>
<!-- ===================================
     HOW IT WORKS
=================================== -->

<section class="process reveal-left">

    <div class="container">

        <div class="section-heading">

            <span>APPLICATION PROCESS</span>

            <h2>

                Get Your Hostel
                In Four Easy Steps

            </h2>

            <p>

                Our digital process makes hostel allocation
                simple, fast and transparent.

            </p>

        </div>

        <div class="timeline">

            <div class="timeline-item">

                <div class="timeline-circle">

                    1

                </div>

                <div class="timeline-content">

                    <h3>Create an Account</h3>

                    <p>

                        Register with your student email and
                        complete your profile.

                    </p>

                </div>

            </div>

            <div class="timeline-item">

                <div class="timeline-circle">

                    2

                </div>

                <div class="timeline-content">

                    <h3>Submit Application</h3>

                    <p>

                        Apply for hostel accommodation
                        directly through the portal.

                    </p>

                </div>

            </div>

            <div class="timeline-item">

                <div class="timeline-circle">

                    3

                </div>

                <div class="timeline-content">

                    <h3>Make Payment</h3>

                    <p>

                        Pay securely online after your
                        application has been approved.

                    </p>

                </div>

            </div>

            <div class="timeline-item">

                <div class="timeline-circle">

                    4

                </div>

                <div class="timeline-content">

                    <h3>Receive Your Room</h3>

                    <p>

                        Instantly receive your hostel
                        allocation and room information.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>
