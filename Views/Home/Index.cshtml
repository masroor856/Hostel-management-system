<!-- ===================================
     FAQ
=================================== -->

<section class="faq reveal-up">

    <div class="container">

        <div class="section-heading">

            <span>FAQ</span>

            <h2>

                Frequently Asked Questions

            </h2>

            <p>

                Everything students usually ask about hostel
                application and accommodation.

            </p>

        </div>

        <div class="faq-container">

            <div class="faq-item">

                <button class="faq-question">

                    How do I apply for a hostel?

                    <span class="faq-icon">+</span>

                </button>

                <div class="faq-answer">

                    <p>

                        Register an account, login,
                        complete your profile and submit
                        your hostel application online.

                    </p>

                </div>

            </div>

            <div class="faq-item">

                <button class="faq-question">

                    When can I make payment?

                    <span class="faq-icon">+</span>

                </button>

                <div class="faq-answer">

                    <p>

                        Payment becomes available once your
                        hostel application has been approved.

                    </p>

                </div>

            </div>

            <div class="faq-item">

                <button class="faq-question">

                    Can I change my allocated room?

                    <span class="faq-icon">+</span>

                </button>

                <div class="faq-answer">

                    <p>

                        Room changes depend on hostel
                        management approval and room availability.

                    </p>

                </div>

            </div>

            <div class="faq-item">

                <button class="faq-question">

                    Is online payment secure?

                    <span class="faq-icon">+</span>

                </button>

                <div class="faq-answer">

                    <p>

                        Yes.
                        Payments are processed through
                        secure payment gateways.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>
