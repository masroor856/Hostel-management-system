<section id="contact" class="contact reveal-scale">


    <div class="container">

        <div class="section-heading">

            <span>CONTACT US</span>

            <h2>

                We'd Love To Hear From You

            </h2>

            <p>

                Have questions about hostel accommodation?
                Send us a message and our support team will
                respond as soon as possible.

            </p>

        </div>

        <div class="contact-grid">

            <div class="contact-info">

                <h3>

                    Get In Touch

                </h3>

                <p>

                    Our support team is available to assist
                    students throughout the hostel application
                    process.

                </p>

                <div class="contact-item">

                    <i class="bi bi-geo-alt-fill"></i>

