@model HostelManagementSystem.Models.Payment

@{
    ViewData["Title"] = "Hostel Fee Payment";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var paidSessions = ViewBag.PaidSessions as List<string>
        ?? new List<string>();
}

<div class="container mt-5">

     <a asp-controller="StudentDashboard"
               asp-action="Index"
               class="profile-btn profile-btn-secondary">

            <button type="submit"
                class="btn btn-success btn-lg">
                <i class="bi bi-arrow-left"></i>
                Back to Dashboard
            </button>
            </a>

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-lg">

                <div class="card-header bg-success text-white text-center py-4">

                    <h2 class="mb-1">
                        💳 Hostel Fee Payment
                    </h2>

                    <p class="mb-0">
                        Secure online payment powered by Paystack
                    </p>

                </div>

                <div class="card-body p-5">

                    <div class="text-center mb-4">

                        <h6 class="text-muted">
                            Amount Payable
                        </h6>

                        <h1 class="display-4 text-success fw-bold">

                            ₦@Model.Amount

                        </h1>

                    </div>

                    <div class="card bg-light border-0 mb-4">

                        <div class="card-body">

                            <div class="row">

                                <div class="col-6">
                                    <strong>Application ID</strong>
                                </div>

                                <div class="col-6 text-end">
                                    #@Model.HostelApplicationId
                                </div>

                            </div>

                            <hr />

                            <div class="row">

                                <div class="col-6">
                                    <strong>Payment Method</strong>
                                </div>

                                <div class="col-6 text-end">
                                    Paystack
                                </div>

                            </div>

                            <hr />

                            <div class="row">

                                <div class="col-6">
                                    <strong>Status</strong>
                                </div>

                                <div class="col-6 text-end">

                                    <span class="badge bg-warning text-dark">
                                        Pending Payment
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="HostelApplicationId" />
                        <input type="hidden" asp-for="Amount" />

                        <div class="mb-4">

                            <label asp-for="Session" class="form-label fw-bold">
                                Select Hostel Session
                            </label>

                            <select asp-for="Session" class="form-select" required>

                                <option value="">
                                    -- Select Session --
                                </option>

                                @if (paidSessions.Contains("Session 1"))
                                {
                                    <option disabled>
                                        Session 1 (Already Paid)
                                    </option>
                                }
                                else
                                {
                                    <option value="Session 1">
                                        Session 1
                                    </option>
                                }

                                @if (paidSessions.Contains("Session 2"))
                                {
                                    <option disabled>
                                        Session 2 (Already Paid)
                                    </option>
                                }
                                else
                                {
                                    <option value="Session 2">
                                        Session 2
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-success btn-lg">

                                💳 Proceed to Paystack

                            </button>

                        </div>

                    </form>

                    <div class="alert alert-info mt-4">

                        <strong>Note:</strong>

                        Select the session you want to pay for before proceeding to Paystack.

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>