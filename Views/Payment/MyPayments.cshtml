@model IEnumerable<HostelManagementSystem.Models.Payment>

@{
    ViewData["Title"] = "My Payments";
    Layout = "_StudentLayout";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-credit-card-fill text-success me-2"></i>

                My Hostel Payments

            </h2>

            <p class="text-muted mb-0">

                View your payment history, payment sessions and print your receipts.

            </p>

        </div>

        <div>

            <a asp-controller="Payment"
               asp-action="Create"
               class="btn btn-success me-2">

                <i class="bi bi-plus-circle-fill"></i>

                New Payment

            </a>

            <a asp-controller="StudentDashboard"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>

                Dashboard

            </a>

        </div>

    </div>

    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-header bg-success text-white py-3">

            <h5 class="mb-0">

                <i class="bi bi-clock-history me-2"></i>

                Payment History

            </h5>

        </div>

        <div class="card-body p-0">

            @if (Model.Any())
            {

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>#</th>

                                <th>Session</th>

                                <th>Amount</th>

                                <th>Status</th>

                                <th>Date</th>

                                <th>Reference</th>

                                <th class="text-center">

                                    Receipt

                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int sn = 1;
                            }

                            @foreach (var payment in Model.OrderByDescending(x => x.PaymentDate))
                            {

                                <tr>

                                    <td>

                                        @sn

                                    </td>

                                    <td>

                                        @if (string.IsNullOrEmpty(payment.Session))
                                        {

                                            <span class="badge bg-secondary">

                                                Old Payment

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="badge bg-info">

                                                @payment.Session

                                            </span>

                                        }

                                    </td>

                                    <td class="fw-bold text-success">

                                        ₦@payment.Amount.ToString("N2")

                                    </td>

                                    <td>

                                        @if (payment.Status == "Paid")
                                        {

                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle-fill"></i>

                                                Paid

                                            </span>

                                        }
                                        else if (payment.Status == "Pending")
                                        {

                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-clock-fill"></i>

                                                Pending

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle-fill"></i>

                                                Failed

                                            </span>

                                        }

                                    </td>

                                    <td>

                                        @payment.PaymentDate.ToString("dd MMM yyyy")

                                        <br />

                                        <small class="text-muted">

                                            @payment.PaymentDate.ToString("hh:mm tt")

                                        </small>

                                    </td>

                                    <td>

                                        <small>

                                            @payment.TransactionReference

                                        </small>

                                    </td>

                                    <td class="text-center">

                                        @if (payment.Status == "Paid")
                                        {

                                            <a asp-action="Receipt"
                                               asp-route-id="@payment.Id"
                                               class="btn btn-primary btn-sm">

                                                <i class="bi bi-eye-fill"></i>

                                            </a>

                                            <a asp-action="Receipt"
                                               asp-route-id="@payment.Id"
                                               target="_blank"
                                               class="btn btn-success btn-sm">

                                                <i class="bi bi-printer-fill"></i>

                                            </a>

                                        }
                                        else
                                        {

                                            <span class="text-muted">

                                                --

                                            </span>

                                        }

                                    </td>

                                </tr>

                                sn++;

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="text-center py-5">

                    <i class="bi bi-wallet2 display-1 text-muted"></i>

                    <h4 class="mt-3">

                        No Payment History

                    </h4>

                    <p class="text-muted">

                        You have not made any hostel payment yet.

                    </p>

                    <a asp-action="Create"
                       class="btn btn-success mt-2">

                        <i class="bi bi-credit-card-fill me-2"></i>

                        Make Payment

                    </a>

                </div>

            }

        </div>

    </div>

</div>