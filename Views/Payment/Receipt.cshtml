@model HostelManagementSystem.Models.Payment

@{
    ViewData["Title"] = "Payment Receipt";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Official Payment Receipt</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        body {
            background: #eef2f7;
            font-family: "Segoe UI", sans-serif;
        }

        .receipt-box {
            max-width: 850px;
            margin: 40px auto;
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,.15);
        }

        .receipt-header {
            background: #198754;
            color: white;
            padding: 30px;
        }

        .receipt-header h2 {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .receipt-header p {
            margin: 0;
            opacity: .9;
        }

        .receipt-body {
            padding: 35px;
        }

        .paid-stamp {
            border: 4px solid #198754;
            color: #198754;
            display: inline-block;
            padding: 10px 30px;
            font-size: 28px;
            font-weight: bold;
            transform: rotate(-12deg);
            margin-bottom: 25px;
        }

        .section-title {
            font-weight: 600;
            color: #198754;
            border-bottom: 2px solid #198754;
            padding-bottom: 6px;
            margin-top: 20px;
            margin-bottom: 15px;
        }

        table td,
        table th {
            vertical-align: middle;
        }

        .signature {
            margin-top: 60px;
        }

        .signature-line {
            border-top: 1px solid #000;
            width: 220px;
            padding-top: 8px;
        }

        .receipt-footer {
            background: #f8f9fa;
            padding: 20px;
            text-align: center;
            color: #666;
            font-size: 14px;
        }

        @@media print {

            body {
                background: white;
            }

            .no-print {
                display: none !important;
            }

            .receipt-box {
                box-shadow: none;
                margin: 0;
                max-width: 100%;
                border: none;
            }

        }

    </style>

</head>

<body>

<div class="receipt-box">

    <div class="receipt-header text-center">

        <h2>
            <i class="bi bi-building-fill"></i>
            HOSTEL MANAGEMENT SYSTEM
        </h2>

        <p>Official Hostel Accommodation Payment Receipt</p>

    </div>

    <div class="receipt-body">

        <div class="text-center">

            <div class="paid-stamp">

                PAID

            </div>

        </div>

        <h4 class="section-title">

            Receipt Information

        </h4>

        <table class="table table-bordered">

            <tr>
                <th width="35%">Receipt Number</th>
                <td>RCPT-@Model.Id.ToString("000000")</td>
            </tr>

            <tr>
                <th>Transaction Reference</th>
                <td>@Model.TransactionReference</td>
            </tr>

            <tr>
                <th>Payment Date</th>
                <td>@Model.PaymentDate.ToString("dddd, dd MMMM yyyy")</td>
            </tr>

            <tr>
                <th>Status</th>
                <td>
                    <span class="badge bg-success fs-6">
                        @Model.Status
                    </span>
                </td>
            </tr>

        </table>

        <h4 class="section-title">

            Student Information

        </h4>

        <table class="table table-bordered">

            <tr>
                <th width="35%">Student Name</th>
                <td>@Model.HostelApplication.Student.FullName</td>
            </tr>

            <tr>
                <th>Email Address</th>
                <td>@Model.HostelApplication.Student.Email</td>
            </tr>

            <tr>
                <th>Room Number</th>
                <td>@Model.HostelApplication.HostelRoom.RoomNumber</td>
            </tr>

        </table>

        <h4 class="section-title">

            Payment Summary

        </h4>

        <table class="table table-bordered">

            <tr>
                <th width="35%">Accommodation Fee</th>
                <td class="fw-bold text-success fs-5">
                    ₦@Model.Amount.ToString("N2")
                </td>
            </tr>

            <tr>
                <th>Payment Method</th>
                <td>Paystack Online Payment</td>
            </tr>

        </table>

        <div class="alert alert-success mt-4">

            <strong>Payment Confirmed</strong>

            <hr />

            This receipt confirms that payment for hostel accommodation has been received successfully.

            Please keep this receipt for your records.

        </div>

        <div class="row signature">

            <div class="col-6">

                <div class="signature-line">

                    Student Signature

                </div>

            </div>

            <div class="col-6 text-end">

                <div class="ms-auto signature-line">

                    Hostel Administrator

                </div>

            </div>

        </div>

    </div>

    <div class="receipt-footer">

        Generated by Hostel Management System<br />

        © 2026 Hostel Management System. All Rights Reserved.

    </div>

</div>

<div class="text-center mt-4 mb-5 no-print">

    <button class="btn btn-success btn-lg me-2"
            onclick="window.print()">

        <i class="bi bi-printer-fill"></i>

        Print Receipt

    </button>

    <a asp-controller="Payment"
       asp-action="MyPayments"
       class="btn btn-secondary btn-lg">

        <i class="bi bi-arrow-left"></i>

        Back to My Payments

    </a>

</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>