@model IEnumerable<HostelManagementSystem.Models.Payment>

@{
    ViewData["Title"] = "Payment Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-credit-card-fill text-primary me-2"></i>

                Payment Management

            </h2>

            <p class="text-muted mb-0">

                Manage all hostel payment transactions.

            </p>

        </div>

        <span class="badge bg-primary fs-6 px-3 py-2">

            Total Payments : @Model.Count()

        </span>

    </div>

    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-header bg-primary text-white py-3">

            <div class="row align-items-center">

                <div class="col-md-4">

                    <h5 class="mb-0">

                        <i class="bi bi-wallet2 me-2"></i>

                        Payment Records

                    </h5>

                </div>

                <div class="col-md-8">

                    <form asp-action="Index" method="get">

                        <div class="input-group">

                            <input type="text"
                                   name="search"
                                   value="@Context.Request.Query["search"]"
                                   class="form-control"
                                   placeholder="Search Student / Session / Reference..." />

                            <button class="btn btn-light">

                                <i class="bi bi-search"></i>

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>#</th>

                        <th>Student</th>

                        <th>Session</th>

                        <th>Amount</th>

                        <th>Status</th>

                        <th>Date</th>

                        <th>Reference</th>

                        <th class="text-center">

                            Action

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        int sn = 1;

                        foreach (var item in Model.OrderByDescending(x => x.PaymentDate))
                        {

                            <tr>

                                <td>

                                    @sn

                                </td>

                                <td>

                                    <strong>

                                        @item.HostelApplication.Student.FullName

                                    </strong>

                                </td>

                                <td>

                                    @if (string.IsNullOrWhiteSpace(item.Session))
                                    {
                                        <span class="badge bg-secondary">

                                            Old Payment

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">

                                            @item.Session

                                        </span>
                                    }

                                </td>

                                <td class="fw-bold text-success">

                                    ₦@item.Amount.ToString("N2")

                                </td>

                                <td>

                                    @if (item.Status == "Paid")
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Paid

                                        </span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">

                                            <i class="bi bi-clock-fill"></i>

                                            Pending

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-x-circle-fill"></i>

                                            Failed

                                        </span>
                                    }

                                </td>

                                <td>

                                    @item.PaymentDate.ToString("dd MMM yyyy")

                                    <br />

                                    <small class="text-muted">

                                        @item.PaymentDate.ToString("hh:mm tt")

                                    </small>

                                </td>

                                <td>

                                    <small>

                                        @item.TransactionReference

                                    </small>

                                </td>

                                <td class="text-center">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-primary btn-sm">

                                        <i class="bi bi-eye-fill"></i>

                                        Details

                                    </a>

                                </td>

                            </tr>

                            sn++;
                        }
                    }
                    else
                    {

                        <tr>

                            <td colspan="8" class="text-center py-5">

                                <i class="bi bi-credit-card display-1 text-muted"></i>

                                <h4 class="mt-3">

                                    No Payment Records Found

                                </h4>

                                <p class="text-muted">

                                    Payment records will appear here after students make payments.

                                </p>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>