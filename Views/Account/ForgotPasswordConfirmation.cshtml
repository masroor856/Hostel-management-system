@model HostelManagementSystem.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Check Your Email";
    Layout = "_AccountLayout";
}

<div class="login-header">

    <div class="login-icon">

        <i class="bi bi-envelope-check-fill"></i>

    </div>

    <h2>Check Your Email</h2>

    <p>

        If an account exists,
        we've sent a password reset link.

    </p>

</div>

<div class="alert alert-info text-center">

    Check your Inbox, Spam or Junk folder.

</div>

<form asp-action="ResendPasswordResetLink"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Email"
           type="hidden"/>

    <button class="btn btn-warning login-btn w-100">

        <i class="bi bi-arrow-repeat me-2"></i>

        Resend Password Reset Link

    </button>

</form>

<div class="account-links mt-4">

    <a asp-action="Login">

        Back to Login

    </a>

</div>