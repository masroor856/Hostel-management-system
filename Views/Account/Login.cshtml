@model HostelManagementSystem.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
   Layout = "_AccountLayout";
}

<div class="login-header">

    <div class="login-icon">

        <i class="bi bi-person-circle"></i>

    </div>

    <h2>Welcome Back</h2>

    <p>

        Sign in to continue to your Hostel Management dashboard.

    </p>

</div>

<form asp-action="Login" method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"></div>

    <div class="form-floating mb-4">

        <input asp-for="Email"
               class="form-control"
               placeholder="Email Address" />

        <label asp-for="Email"></label>

        <span asp-validation-for="Email"
              class="text-danger"></span>

    </div>

    <div class="form-floating mb-4 position-relative">

        <input asp-for="Password"
               class="form-control"
               id="passwordBox"
               placeholder="Password"
               type="password" />

        <label asp-for="Password"></label>

        <button type="button"
                class="password-toggle"
                onclick="togglePassword()">

            <i class="bi bi-eye" id="eyeIcon"></i>

        </button>

        <span asp-validation-for="Password"
              class="text-danger"></span>

    </div>

    <div class="remember-row">

        <label>

            <input asp-for="RememberMe" />

            Remember me

        </label>

        <a asp-action="ForgotPassword">

            Forgot Password?

        </a>

    </div>

    <button class="btn btn-primary login-btn w-100">

        <i class="bi bi-box-arrow-in-right me-2"></i>

        Login

    </button>

    <div class="account-links">

        <p>

            Don't have an account?

        </p>

        <a asp-action="Register">

            Create Account

        </a>

    </div>

</form>

@section Scripts{

<partial name="_ValidationScriptsPartial" />

<script>

function togglePassword(){

const box=document.getElementById("passwordBox");

const eye=document.getElementById("eyeIcon");

if(box.type==="password"){

box.type="text";

eye.className="bi bi-eye-slash";

}else{

box.type="password";

eye.className="bi bi-eye";

}

}

</script>

}