<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | Hostel Management System</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

   <link rel="stylesheet"
      href="~/css/home.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/animation.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/responsive.css"
      asp-append-version="true" />
      
<link rel="stylesheet" 
      href="~/css/site.css"
      asp-append-version="true" />

<link rel="stylesheet" 
      href="~/css/admin-profile.css"
      asp-append-version="true" />

<link rel="stylesheet" 
      href="~/css/admin.css"
      asp-append-version="true" />

<link rel="stylesheet"
          href="~/HostelManagementSystem.styles.css"
          asp-append-version="true" />

</head>

<body>
    
<div class="admin-wrapper">

    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar">

        <div class="sidebar-header">

            <i class="bi bi-buildings-fill"></i>

            <span>HostelMS</span>

        </div>

        <div class="sidebar-user">

            <div class="avatar">

                <i class="bi bi-person-circle"></i>

            </div>

            <div>

                <h6>Administrator</h6>

                <small>System Control Panel</small>

            </div>

        </div>

        <nav class="sidebar-menu">

            <a asp-controller="AdminDashboard"
               asp-action="Index">

                <i class="bi bi-speedometer2"></i>

                Dashboard

            </a>

            <a asp-controller="Student"
               asp-action="Index">

                <i class="bi bi-people-fill"></i>

                Students

            </a>

            <a asp-controller="HostelRoom"
               asp-action="Index">

                <i class="bi bi-building"></i>

                Hostel Rooms

            </a>

            <a asp-controller="HostelApplication"
               asp-action="Index">

                <i class="bi bi-file-earmark-check"></i>

                Applications

            </a>

            <a asp-controller="Payment"
               asp-action="Index">

                <i class="bi bi-credit-card"></i>

                Payments

            </a>

            <a asp-controller="ContactMessage"
               asp-action="Index">

                <i class="bi bi-envelope-fill"></i>

                Messages

            </a>

            <a asp-controller="Reports"
               asp-action="Index">

                <i class="bi bi-bar-chart-fill"></i>

                Reports

            </a>
        </nav>
       
    </aside>

    <!-- =========================
         MAIN AREA
    ========================== -->

    <div class="main-content">
            <!-- =========================
         TOP NAVBAR
    ========================== -->

    <header class="topbar">

        <div class="topbar-left">

            <button class="menu-toggle">

                <i class="bi bi-list"></i>

            </button>

            <h3>

                @ViewData["Title"]

            </h3>

        </div>

        <div class="topbar-right">

            <form class="search-box"
                  asp-controller="Student"
                  asp-action="Index"
                  method="get">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="search"
                       placeholder="Search student..." />

            </form>
           <a asp-controller="ContactMessage"
   asp-action="Index"
   class="topbar-icon"
   title="Messages">

    <i class="bi bi-envelope-fill"></i>

    @if (ViewBag.UnreadMessages != null && (int)ViewBag.UnreadMessages > 0)
    {
        <span class="badge">
            @ViewBag.UnreadMessages
        </span>
    }

</a>
          <a asp-controller="AdminProfile"
   asp-action="Index"
   class="nav-link">

    <i class="bi bi-person-circle me-2"></i>

    My Profile

</a>

    <form asp-controller="Account"
          asp-action="Logout"
          method="post">

        @Html.AntiForgeryToken()

        <button class="apply-btn logout-btn">
            <i class="bi bi-box-arrow-right"></i> Logout
        </button>
     
    </form>
        </div>
    </header>

    <!-- =========================
         PAGE CONTENT
    ========================== -->

    <main class="page-content">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm">

                <i class="bi bi-check-circle-fill me-2"></i>

                @TempData["Success"]

                <button class="btn-close"
                        data-bs-dismiss="alert"></button>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm">

                <i class="bi bi-exclamation-circle-fill me-2"></i>

                @TempData["Error"]

                <button class="btn-close"
                        data-bs-dismiss="alert"></button>

            </div>
        }

        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                @TempData["Warning"]

                <button class="btn-close"
                        data-bs-dismiss="alert"></button>

            </div>
        }

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm">

                <i class="bi bi-info-circle-fill me-2"></i>

                @TempData["Info"]

                <button class="btn-close"
                        data-bs-dismiss="alert"></button>

            </div>
        }

        @RenderBody()

    </main>
      
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

<script src="~/js/home.js"
        asp-append-version="true"></script>

<script>

const toggle = document.querySelector(".menu-toggle");

const sidebar = document.querySelector(".sidebar");

if(toggle){

    toggle.addEventListener("click", function(){

        sidebar.classList.toggle("show");

    });

}

</script>

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>