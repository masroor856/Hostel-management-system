<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] | Hostel Management System</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<link rel="stylesheet"
      href="~/css/home.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/animation.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/responsive.css"
      asp-append-version="true" />
      
<link rel="stylesheet" 
      href="~/css/site.css"
      asp-append-version="true" />

<link rel="stylesheet" 
      href="~/css/admin.css"
      asp-append-version="true" />

<link rel="stylesheet"
          href="~/HostelManagementSystem.styles.css"
          asp-append-version="true" />

</head>

<body>
    <!-- =========================================
PAGE LOADER
========================================= -->

<div id="page-loader">

    <div class="loader-wrapper">

        <div class="loader-logo">

            <div class="loader-circle">

                <i class="bi bi-buildings-fill"></i>

            </div>

        </div>

        <h2 class="loader-title">
            Hostel Management System
        </h2>

        <p id="loader-message">

            Preparing Hostel Management System...

        </p>

        <div class="loader-progress">

            <div class="loader-progress-bar"></div>

        </div>

    </div>

</div>

<!-- =========================================
PAGE TRANSITION
========================================= -->

<div id="page-transition"></div>
  <header class="account-navbar">

    <div class="container">

        <div class="account-nav">

            <a asp-controller="Home"
               asp-action="Index"
               class="logo">

                <i class="bi bi-buildings-fill"></i>

                HostelMS

            </a>

            <nav>

                <a asp-controller="Home"
                   asp-action="Index">

                    Home

                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="features">

                    Features

                </a>

                <a asp-controller="Home"
                   asp-action="Rooms">
                   Rooms

                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="contact">

                    Contact

                </a>
                 
                 <a asp-controller="Account"
                   asp-action="Login"
                    class="apply-btn">

                    Login

                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="apply-btn">

                    Apply Now

                </a>

            </nav>

        </div>

    </div>

</header>

<main>

@if (TempData["Success"] != null)
{
<div class="container mt-5 pt-5">

<div class="alert alert-success alert-dismissible fade show">

<i class="bi bi-check-circle-fill me-2"></i>

@TempData["Success"]

<button class="btn-close"
        data-bs-dismiss="alert"></button>

</div>

</div>
}

@if (TempData["Error"] != null)
{
<div class="container mt-5 pt-5">

<div class="alert alert-danger alert-dismissible fade show">

<i class="bi bi-exclamation-circle-fill me-2"></i>

@TempData["Error"]

<button class="btn-close"
        data-bs-dismiss="alert"></button>

</div>

</div>
}

@if (TempData["Warning"] != null)
{
<div class="container mt-5 pt-5">

<div class="alert alert-warning alert-dismissible fade show">

<i class="bi bi-exclamation-triangle-fill me-2"></i>

@TempData["Warning"]

<button class="btn-close"
        data-bs-dismiss="alert"></button>

</div>

</div>
}

@if (TempData["Info"] != null)
{
<div class="container mt-5 pt-5">

<div class="alert alert-info alert-dismissible fade show">

<i class="bi bi-info-circle-fill me-2"></i>

@TempData["Info"]

<button class="btn-close"
        data-bs-dismiss="alert"></button>

</div>

</div>
}

@RenderBody()

</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

<script src="~/js/home.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>