@model HostelManagementSystem.Models.HostelRoom

@{
    ViewData["Title"] = "Room Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">

                <i class="bi bi-building floating-icon me-2"></i>

                Room @Model.RoomNumber

            </h2>

            <p class="text-muted mb-0">

                View room information and allocated students.

            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back to Rooms

        </a>

    </div>


    <!-- =========================
         ROOM DETAILS
    ========================== -->

    <div class="row g-4">

        <!-- =========================
             ROOM INFORMATION
        ========================== -->

        <div class="col-lg-4">

            <div class="card shadow border-0 h-100">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">

                        <i class="bi bi-info-circle me-2"></i>

                        Room Information

                    </h5>

                </div>

                <div class="card-body">

                    <!-- ROOM NUMBER -->

                    <div class="mb-4">

                        <small class="text-muted d-block mb-1">
                            Room Number
                        </small>

                        <strong class="fs-5">
                            @Model.RoomNumber
                        </strong>

                    </div>


                    <!-- HOSTEL CATEGORY -->

                    <div class="mb-4">

                        <small class="text-muted d-block mb-2">
                            Hostel Category
                        </small>

                        @if (Model.HostelType == "Boys")
                        {
                            <span class="badge bg-primary px-3 py-2">

                                <i class="bi bi-gender-male me-1"></i>

                                Boys Hostel

                            </span>
                        }
                        else if (Model.HostelType == "Girls")
                        {
                            <span class="badge bg-danger px-3 py-2">

                                <i class="bi bi-gender-female me-1"></i>

                                Girls Hostel

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2">

                                <i class="bi bi-building me-1"></i>

                                @Model.HostelType

                            </span>
                        }

                    </div>


                    <!-- PRICE -->

                    <div class="mb-4">

                        <small class="text-muted d-block mb-1">
                            Price
                        </small>

                        <strong class="fs-5 text-success">

                            ₦@Model.Price.ToString("N2")

                        </strong>

                    </div>


                    <!-- CAPACITY -->

                    <div class="mb-4">

                        <small class="text-muted d-block mb-1">
                            Capacity
                        </small>

                        <strong>

                            @Model.Capacity beds

                        </strong>

                    </div>


                    <!-- OCCUPIED -->

                    <div class="mb-4">

                        <small class="text-muted d-block mb-1">
                            Occupied Space
                        </small>

                        <strong class="text-danger">

                            @Model.OccupiedSpace

                        </strong>

                    </div>


                    <!-- AVAILABLE -->

                    <div class="mb-4">

                        <small class="text-muted d-block mb-1">
                            Available Space
                        </small>

                        <strong class="text-success">

                            @Model.AvailableSpace

                        </strong>

                    </div>


                    <!-- STATUS -->

                    <div>

                        <small class="text-muted d-block mb-2">
                            Status
                        </small>

                        @if (Model.IsAvailable && Model.AvailableSpace > 0)
                        {
                            <span class="badge bg-success px-3 py-2">

                                <i class="bi bi-check-circle me-1"></i>

                                Available

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger px-3 py-2">

                                <i class="bi bi-x-circle me-1"></i>

                                Full

                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================
             STUDENTS IN ROOM
        ========================== -->

        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-header bg-dark text-white">

                    <h5 class="mb-0">

                        <i class="bi bi-people-fill me-2"></i>

                        Students in Room @Model.RoomNumber

                    </h5>

                </div>

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover mb-0 align-middle">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Name
                                    </th>

                                    <th>
                                        Email
                                    </th>

                                    <th>
                                        Hostel Category
                                    </th>

                                    <th>
                                        Date Allocated
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @if (Model.RoomAllocations != null &&
                                     Model.RoomAllocations.Any())
                                {
                                    foreach (var allocation in Model.RoomAllocations)
                                    {
                                        <tr>

                                            <!-- STUDENT NAME -->

                                            <td>

                                                <strong>
                                                    @allocation.Student.FullName
                                                </strong>

                                            </td>


                                            <!-- EMAIL -->

                                            <td>

                                                @allocation.Student.Email

                                            </td>


                                            <!-- HOSTEL CATEGORY -->

                                            <td>

                                                @if (Model.HostelType == "Boys")
                                                {
                                                    <span class="badge bg-primary">

                                                        <i class="bi bi-gender-male me-1"></i>

                                                        Boys

                                                    </span>
                                                }
                                                else if (Model.HostelType == "Girls")
                                                {
                                                    <span class="badge bg-danger">

                                                        <i class="bi bi-gender-female me-1"></i>

                                                        Girls

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">

                                                        @Model.HostelType

                                                    </span>
                                                }

                                            </td>


                                            <!-- DATE -->

                                            <td>
                                        @allocation.AllocationDate.ToString("dd MMM yyyy, hh:mm tt")
                                    </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="4"
                                            class="text-center py-5 text-muted">

                                            <i class="bi bi-people fs-1 d-block mb-3"></i>

                                            No students allocated to this room.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         ACTION BUTTONS
    ========================== -->

    <div class="mt-4">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning me-2">

            <i class="bi bi-pencil-square me-1"></i>

            Edit Room

        </a>


        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-danger">

            <i class="bi bi-trash me-1"></i>

            Delete Room

        </a>

    </div>

</div>