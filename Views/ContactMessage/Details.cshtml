@model HostelManagementSystem.Models.ContactMessage

@{
    ViewData["Title"] = "Message Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-envelope-open-fill text-primary me-2"></i>

                Message Details

            </h2>

            <p class="text-muted">

                Read messages sent from your website.

            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>

            Back

        </a>

    </div>

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                Contact Information

            </h5>

        </div>

        <div class="card-body">

            <table class="table table-bordered">

                <tr>

                    <th width="25%">Full Name</th>

                    <td>@Model.FullName</td>

                </tr>

                <tr>

                    <th>Email</th>

                    <td>

                        <a href="mailto:@Model.Email">

                            @Model.Email

                        </a>

                    </td>

                </tr>

                <tr>

                    <th>Date Sent</th>

                    <td>

                        @Model.DateSent.ToString("dddd, dd MMMM yyyy hh:mm tt")

                    </td>

                </tr>

                <tr>

                    <th>Status</th>

                    <td>

                        @if (Model.IsRead)
                        {
                            <span class="badge bg-success">

                                Read

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">

                                Unread

                            </span>
                        }

                    </td>

                </tr>

                <tr>

                    <th>Message</th>

                    <td style="white-space:pre-wrap;">

                        @Model.Message

                    </td>

                </tr>

            </table>

        </div>

        <div class="card-footer text-end">

            <a href="mailto:@Model.Email"
               class="btn btn-success">

                <i class="bi bi-reply-fill"></i>

                Reply

            </a>

            <a asp-controller="ContactMessage"
            asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger ms-2"
               onclick="return confirm('Delete this message?');">

                <i class="bi bi-trash-fill"></i>

                Delete

            </a>

        </div>

    </div>

</div>