@{
    ViewData["Title"] = "System Reports";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 no-print">

        <h2 class="fw-bold">
            <i class="bi bi-bar-chart-fill text-primary"></i>
            System Reports
        </h2>

        <button onclick="window.print()" class="btn btn-success">
            <i class="bi bi-printer-fill"></i>
            Print Report
        </button>

    </div>

    <div class="text-center mb-5">

        <h2 class="fw-bold">
            HOSTEL MANAGEMENT SYSTEM
        </h2>

        <h5>Administrative Report</h5>

        <p class="text-muted">
            Generated on @DateTime.Now.ToString("dddd, dd MMMM yyyy HH:mm")
        </p>

        <hr />

    </div>

    <div class="row">

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow border-0 bg-primary text-white">
                <div class="card-body text-center">
                    <i class="bi bi-people-fill display-5"></i>
                    <h6 class="mt-3">Total Students</h6>
                    <h2>@ViewBag.TotalStudents</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow border-0 bg-success text-white">
                <div class="card-body text-center">
                    <i class="bi bi-building display-5"></i>
                    <h6 class="mt-3">Total Rooms</h6>
                    <h2>@ViewBag.TotalRooms</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow border-0 bg-warning text-dark">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-check-fill display-5"></i>
                    <h6 class="mt-3">Applications</h6>
                    <h2>@ViewBag.TotalApplications</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow border-0 bg-info text-white">
                <div class="card-body text-center">
                    <i class="bi bi-credit-card-fill display-5"></i>
                    <h6 class="mt-3">Payments</h6>
                    <h2>@ViewBag.TotalPayments</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="row">

        <div class="col-lg-4 mb-4">
            <div class="card shadow border-success">
                <div class="card-body text-center">
                    <h5>Total Revenue</h5>
                    <h2 class="text-success">
                        ₦@ViewBag.TotalRevenue.ToString("N2")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card shadow border-primary">
                <div class="card-body text-center">
                    <h5>Available Rooms</h5>
                    <h2 class="text-primary">
                        @ViewBag.AvailableRooms
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card shadow border-danger">
                <div class="card-body text-center">
                    <h5>Occupied Rooms</h5>
                    <h2 class="text-danger">
                        @ViewBag.OccupiedRooms
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow border-0 mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                <i class="bi bi-credit-card-fill"></i>
                Recent Payments
            </h5>

        </div>

        <div class="card-body">

            <table class="table table-striped table-hover">

                <thead class="table-light">

                    <tr>
                        <th>Student</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>

                </thead>

                <tbody>

                @foreach (var payment in ViewBag.RecentPayments)
                {
                    <tr>

                        <td>@payment.HostelApplication.Student.FullName</td>

                        <td>
                            ₦@payment.Amount.ToString("N2")
                        </td>

                        <td>

                            @if(payment.Status=="Paid")
                            {
                                <span class="badge bg-success">
                                    Paid
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    @payment.Status
                                </span>
                            }

                        </td>

                        <td>
                            @payment.PaymentDate.ToShortDateString()
                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

    <div class="card shadow border-0">

        <div class="card-header bg-success text-white">

            <h5 class="mb-0">
                <i class="bi bi-journal-check"></i>
                Recent Applications
            </h5>

        </div>

        <div class="card-body">

            <table class="table table-striped table-hover">

                <thead class="table-light">

                    <tr>

                        <th>Student</th>
                        <th>Room</th>
                        <th>Status</th>
                        <th>Date</th>

                    </tr>

                </thead>

                <tbody>

                @foreach (var application in ViewBag.RecentApplications)
                {
                    <tr>

                        <td>@application.Student.FullName</td>

                        <td>@application.HostelRoom.RoomNumber</td>

                        <td>

                            @if(application.Status=="Accepted")
                            {
                                <span class="badge bg-success">
                                    Accepted
                                </span>
                            }
                            else if(application.Status=="Pending")
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    @application.Status
                                </span>
                            }

                        </td>

                        <td>
                            @application.ApplicationDate.ToShortDateString()
                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

@@media print {

    .no-print,
    .sidebar,
    .navbar,
    footer {
        display: none !important;
    }

    body {
        background: white !important;
    }

    .container-fluid {
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .card {
        border: 1px solid #ddd !important;
        box-shadow: none !important;
        page-break-inside: avoid;
    }

    .table {
        font-size: 12px;
    }

}

</style>