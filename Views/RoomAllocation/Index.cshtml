@model IEnumerable<HostelManagementSystem.Models.RoomAllocation>

@{
    ViewData["Title"] = "Room Allocations";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-house-check-fill text-primary me-2"></i>
                Room Allocations
            </h2>

            <p class="text-muted mb-0">
                Manage and monitor student room allocations.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>
            New Allocation
        </a>

    </div>

    <div class="card shadow border-0 rounded-3">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="bi bi-list-check text-primary me-2"></i>
                Allocation Records
            </h5>
        </div>

        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th><i class="bi bi-person-fill me-1"></i>Student</th>
                        <th><i class="bi bi-building me-1"></i>Room</th>
                        <th><i class="bi bi-calendar-event me-1"></i>Allocation Date</th>
                        <th><i class="bi bi-check-circle me-1"></i>Status</th>
                        <th class="text-end">
                            <i class="bi bi-gear-fill me-1"></i>Actions
                        </th>
                    </tr>

                </thead>

                <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <i class="bi bi-person-circle text-primary me-2"></i>
                                @item.Student.FullName
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @item.HostelRoom.RoomNumber
                                </span>
                            </td>

                            <td>
                                @item.AllocationDate.ToString("dd MMM yyyy")
                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-x-circle-fill"></i>
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td class="text-end">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-info btn-sm">

                                    <i class="bi bi-eye-fill"></i>
                                    Details

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-warning btn-sm">

                                    <i class="bi bi-pencil-square"></i>
                                    Edit

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-danger btn-sm">

                                    <i class="bi bi-trash-fill"></i>
                                    Delete

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5" class="text-center py-5">

                            <i class="bi bi-house-x display-4 text-muted"></i>

                            <h5 class="mt-3 text-muted">
                                No Room Allocations Found
                            </h5>

                            <p class="text-muted">
                                Create a new allocation to get started.
                            </p>

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>