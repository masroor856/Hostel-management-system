@model HostelManagementSystem.DTOs.StudentDashboardDto

@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "_StudentLayout";

    var application = Model.HostelApplications?.FirstOrDefault();
      var payment = application?.Payments?
    .OrderByDescending(p => p.Status == "Paid")
    .ThenByDescending(p => p.PaymentDate)
    .FirstOrDefault();
    var greeting = DateTime.Now.Hour switch
{
    < 12 => "Good Morning",
    < 17 => "Good Afternoon",
    _ => "Good Evening"
};
}

<div class="d-flex align-items-center mb-4">

    <img src="@(string.IsNullOrEmpty(Model.ProfilePicture)
        ? "/images/default-user.png"
        : Model.ProfilePicture)"
         class="rounded-circle shadow border me-3"
         width="80"
         height="80"
         style="object-fit:cover;" />

    <div>

        <h3 class="fw-bold">
            @greeting, @Model.FullName

        </h3>

        <p class="text-muted mb-0">

            @Model.Email

        </p>

    </div>

</div>
    <!-- Statistics Cards -->

@if (application != null)
{
    <div class="row g-4 mb-5">

        <!-- Application -->

        <div class="col-lg-3 col-md-6">

    <div class="card dashboard-card border-0 shadow-sm">

        <div class="card-body d-flex align-items-center">

            <div class="icon-box bg-info text-white me-3">

                <i class="bi bi-mortarboard-fill"></i>

            </div>

            <div>

                <small class="text-muted">
                    Department
                </small>

                <h6 class="fw-bold mb-0">

                    @Model.Department

                </h6>

            </div>

        </div>

    </div>

</div>
        <div class="col-lg-3 col-md-6">

            <div class="card dashboard-card border-0 shadow-sm">

                <div class="card-body d-flex align-items-center">

                    <div class="icon-box bg-success text-white me-3">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>

                    <div>

                        <small class="text-muted">Application</small>

                        <h4 class="fw-bold mb-0">
                            @application.Status
                        </h4>

                    </div>

                </div>

            </div>

        </div>

        <!-- Room -->
        <div class="col-lg-3 col-md-6">

            <div class="card dashboard-card border-0 shadow-sm">

                <div class="card-body d-flex align-items-center">

                    <div class="icon-box bg-primary text-white me-3">
                      <i class="bi bi-building floating-icon"></i>
                    </div>

                    <div>

                        <small class="text-muted">Room Number</small>

                        <h4 class="fw-bold mb-0">
                            @(Model.RoomAllocation?.HostelRoom?.RoomNumber ?? "N/A")
                        </h4>

                    </div>

                </div>

            </div>

        </div>

        <!-- Hostel Fee -->
        <div class="col-lg-3 col-md-6">

            <div class="card dashboard-card border-0 shadow-sm">

                <div class="card-body d-flex align-items-center">

                    <div class="icon-box bg-warning text-white me-3">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <div>

                        <small class="text-muted">Hostel Fee</small>

                        <h4 class="fw-bold mb-0">
                            ₦@application.HostelRoom?.Price
                        </h4>

                    </div>

                </div>

            </div>

        </div>

    </div>
}
<!-- Quick Actions -->

<div class="card border-0 shadow-lg mb-5">

    <div class="card-header bg-white border-0 pt-4">

        <h3 class="fw-bold">

            <i class="bi bi-lightning-charge-fill text-warning me-2"></i>

            Quick Actions

        </h3>

    </div>

    <div class="card-body">

        <div class="row g-4">

            <!-- Apply -->

            <div class="col-lg-4">

                <a asp-controller="HostelApplication"
                   asp-action="Apply"
                   class="text-decoration-none">

                    <div class="action-card">

                        <div class="action-icon bg-primary">

                            <i class="bi bi-house-add-fill"></i>

                        </div>

                        <h5 class="fw-bold mt-3">

                            Apply Hostel

                        </h5>

                        <p class="text-muted mb-0">

                            Submit a new hostel application.

                        </p>

                    </div>

                </a>

            </div>

            <!-- Payments -->

            <div class="col-lg-4">

                <a asp-controller="Payment"
                   asp-action="MyPayments"
                   class="text-decoration-none">

                    <div class="action-card">

                        <div class="action-icon bg-success">

                            <i class="bi bi-credit-card-fill"></i>

                        </div>

                        <h5 class="fw-bold mt-3">

                            My Payments

                        </h5>

                        <p class="text-muted mb-0">

                            View payment history.

                        </p>

                    </div>

                </a>

            </div>
            <div class="col-lg-3 col-md-6">

    <a asp-controller="Payment"
       asp-action="Create"
       class="text-decoration-none">

        <div class="action-card">

            <div class="action-icon bg-success">

                <i class="bi bi-credit-card-fill"></i>

            </div>

            <h5 class="fw-bold mt-3">

                Pay Hostel Fee

            </h5>

            <p class="text-muted mb-0">

                Pay for a hostel session

            </p>

        </div>

    </a>

</div>

            <!-- Profile -->

            <div class="col-lg-4">

                <a asp-action="Profile"
                   class="text-decoration-none">

                    <div class="action-card">

                        <div class="action-icon bg-warning">
                           
                            <i class="bi bi-person-circle"></i>

                        </div>

                        <h5 class="fw-bold mt-3">

                            My Profile

                        </h5>

                        <p class="text-muted mb-0">

                            View and edit your profile.

                        </p>

                    </div>

                </a>

            </div>

        </div>

    </div>

</div>
@if (application != null)
{
    <div class="row g-4 mb-5">

        <!-- Room Information -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4">

                    <h4 class="fw-bold">

                        <i class="bi bi-house-door-fill text-primary me-2"></i>

                        Room Information

                    </h4>

                </div>

                <div class="card-body">

                    <table class="table table-borderless align-middle">

                        <tr>

                            <th class="text-muted">Room Number</th>

                            <td class="fw-bold">

                                @(Model.RoomAllocation?.HostelRoom?.RoomNumber ?? "Not Allocated")

                            </td>

                        </tr>

                        <tr>

                            <th class="text-muted">Application Date</th>

                            <td>

                                @application.ApplicationDate.ToString("dd MMM yyyy")

                            </td>

                        </tr>

                        <tr>

                            <th class="text-muted">Hostel Fee</th>

                            <td>

                                ₦@application.HostelRoom?.Price

                            </td>

                        </tr>

                        <tr>

                            <th class="text-muted">Status</th>

                            <td>

                                @if(application.Status=="Accepted")
                                {
                                    <span class="badge bg-success">
                                        Accepted
                                    </span>
                                }
                                else if(application.Status=="Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        @application.Status
                                    </span>
                                }

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

   <!-- Payment -->

<div class="col-lg-6">

    <div class="card border-0 shadow-sm h-100">

        <div class="card-header bg-white border-0 pt-4">

            <h4 class="fw-bold">

                <i class="bi bi-credit-card-fill text-success me-2"></i>

                Payment Status

            </h4>

        </div>

        <div class="card-body">

            @if (payment != null)
            {

                <div class="mb-4">

                    <h2 class="fw-bold">

                        ₦@payment.Amount.ToString("N2")

                    </h2>

                </div>


                <!-- PAYMENT STATUS -->

                <p>

                    <strong>Status:</strong>

                    @if (payment.Status == "Paid")
                    {
                        <span class="badge bg-success ms-2">

                            <i class="bi bi-check-circle me-1"></i>

                            Paid

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark ms-2">

                            <i class="bi bi-clock me-1"></i>

                            Pending

                        </span>
                    }

                </p>


                <!-- PAID SESSION -->

                <p>

                    <strong>Hostel Session:</strong>

                    <span class="badge bg-primary ms-2">

                        <i class="bi bi-calendar-event me-1"></i>

                        @payment.Session

                    </span>

                </p>


                <!-- PAYMENT DATE -->

                <p>

                    <strong>Payment Date:</strong>

                    @payment.PaymentDate.ToString("dd MMM yyyy")

                </p>

            }
            else
            {

                <div class="alert alert-warning mb-0">

                    <i class="bi bi-exclamation-triangle me-2"></i>

                    No payment record found.

                </div>

            }

        </div>

    </div>

</div>
    </div>
}
@if (application != null)
{
    <div class="card border-0 shadow-lg mb-5">

        <div class="card-header bg-white">

            <h4 class="fw-bold">

                <i class="bi bi-clock-history text-primary me-2"></i>

                Recent Activity

            </h4>

        </div>

        <div class="card-body">

            <div class="timeline">

                <div class="timeline-item">

                    <div class="timeline-icon bg-primary">
                        <i class="bi bi-file-earmark-check-fill"></i>
                    </div>

                    <div>

                        <h6 class="fw-bold">

                            Hostel Application Submitted

                        </h6>

                        <small class="text-muted">

                            @application.ApplicationDate.ToString("dd MMM yyyy")

                        </small>

                    </div>

                </div>

                @if (payment != null)
                {
                    <div class="timeline-item">

                        <div class="timeline-icon @(payment.Status=="Paid" ? "bg-success":"bg-warning")">

                            <i class="bi bi-credit-card-fill"></i>

                        </div>

                        <div>

                            <h6 class="fw-bold">

                                Hostel Payment @payment.Status

                            </h6>

                            <small class="text-muted">

                                @payment.PaymentDate.ToString("dd MMM yyyy")

                            </small>

                        </div>

                    </div>
                }

                @if(Model.RoomAllocation != null)
                {
                    <div class="timeline-item">

                        <div class="timeline-icon bg-info">

                            <i class="bi bi-house-check-fill"></i>

                        </div>

                        <div>

                            <h6 class="fw-bold">

                                Room Allocated

                            </h6>

                            <small class="text-muted">

                                Room @Model.RoomAllocation.HostelRoom.RoomNumber

                            </small>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>
}

<div class="row mb-5">

    <div class="col-lg-6">

        <div class="card border-0 shadow-lg bg-primary text-white">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between">

                    <div>

                        <h3 class="fw-bold">

                            Student ID Card

                        </h3>

                        <hr class="border-light"/>

                        <h4>@Model.FullName</h4>

                        <p class="mb-1">

                            <strong>Email:</strong>

                            @Model.Email

                        </p>

                        <p class="mb-1">

                            <strong>Phone:</strong>

                            @(Model.PhoneNumber ?? "Not Added")

                        </p>
                         
                           <p class="mb-1">

                            <strong>Department:</strong>

                            @(Model.Department ?? "Not Added")

                        </p>

                        <p class="mb-1">

                            <strong>Gender:</strong>

                            @(Model.Gender ?? "Not Specified")

                        </p>

                        <p class="mb-0">

                            <strong>Student ID:</strong>

                            HMS-@Model.Id.ToString("D5")

                        </p>

                    </div>

                    <div>

                        <i class="bi bi-person-badge-fill display-1 opacity-50"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-6">

        <div class="card border-0 shadow-lg">

            <div class="card-body p-4 text-center">

                <h4 class="fw-bold mb-4">

                    Account Summary

                </h4>

                <div class="row">

                    <div class="col-4">

                        <i class="bi bi-house-fill display-6 text-primary"></i>

                        <h6 class="mt-2">

                            Room

                        </h6>

                        <strong>

                            @(Model.RoomAllocation?.HostelRoom?.RoomNumber ?? "N/A")

                        </strong>

                    </div>

                    <div class="col-4">

                        <i class="bi bi-credit-card-fill display-6 text-success"></i>

                        <h6 class="mt-2">

                            Payment

                        </h6>

                        <strong>

                            @(payment?.Status ?? "Pending")

                        </strong>

                    </div>

                    <div class="col-4">

                        <i class="bi bi-check-circle-fill display-6 text-warning"></i>

                        <h6 class="mt-2">

                            Status

                        </h6>

                        <strong>

                            @(application?.Status ?? "None")

                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
<style>

.dashboard-card{
    border-radius:20px;
    transition:.35s;
    overflow:hidden;
}

.dashboard-card:hover{
    transform:translateY(-8px);
    box-shadow:0 20px 45px rgba(0,0,0,.12);
}

.icon-box{
    width:65px;
    height:65px;
    border-radius:18px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:28px;
    flex-shrink:0;
}

.action-card{
    background:#fff;
    border-radius:20px;
    padding:35px 25px;
    text-align:center;
    transition:.35s;
    border:1px solid #eef2f7;
    height:100%;
}

.action-card:hover{
    transform:translateY(-8px);
    box-shadow:0 20px 40px rgba(0,0,0,.12);
}

.action-icon{
    width:75px;
    height:75px;
    border-radius:20px;
    margin:auto;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#fff;
    font-size:30px;
}

.card{
    border-radius:20px;
}

.card-header{
    border-bottom:none;
}

.table th{
    width:40%;
    color:#64748b;
    font-weight:600;
}

.table td{
    font-weight:500;
}

.badge{
    border-radius:30px;
    padding:8px 16px;
    font-size:.85rem;
}

.btn{
    border-radius:12px;
}

.timeline{
    position:relative;
    margin-left:25px;
}

.timeline::before{
    content:'';
    position:absolute;
    left:18px;
    top:0;
    width:3px;
    height:100%;
    background:#dee2e6;
}

.timeline-item{
    position:relative;
    display:flex;
    gap:20px;
    margin-bottom:35px;
}

.timeline-icon{
    width:40px;
    height:40px;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#fff;
    position:relative;
    z-index:2;
}

.card:hover{

    transform:translateY(-5px);

    transition:.3s;

}

.bg-primary{

    background:linear-gradient(135deg,#0d6efd,#3b82f6)!important;

}

</style>